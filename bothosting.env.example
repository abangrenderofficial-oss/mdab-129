# MediaX Downloader — Bot Hosting ENV template (NO secrets)
# Copy these names into Bot Hosting ENV panel, NOT into GitHub.
#
# REQUIRED: use existing production secrets from Railway (values are not exported here)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
BOT_OWNER_ID=
SETUP_SECRET=
PUBLIC_BASE_URL=
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
GITHUB_ACTIONS_TOKEN=
BAYARCASH_API_SECRET_KEY=
BAYARCASH_API_TOKEN=
BAYARCASH_PORTAL_KEY=
BAYARCASH_SANDBOX=false
PAYPING_SHARED_CONFIG_ENABLED=true

# Bot Hosting safety: turn on only when migrating from Railway.
# Old Railway worker must be stopped / background jobs disabled first.
MEDIAX_BOTHOSTING_ACTIVE=false
# For one-deploy cutover: set true ONLY at final approved switchover.
MEDIAX_BOTHOSTING_AUTO_WEBHOOK=false
MEDIAX_BOTHOSTING_CUTOVER_APPROVED=false

# Optional, only if already configured in Railway:
BAYARCASH_PAYER_EMAIL=
CONTENT_MANAGER_URL=
CONTENT_BRIDGE_SECRET=
WEBPUSH_VAPID_PUBLIC_KEY=
WEBPUSH_VAPID_PRIVATE_KEY=
WEBPUSH_VAPID_SUBJECT=
NTFY_PAYMENT_TOPIC=
AFFILIATE_COMMISSION_PERCENT=
AFFILIATE_HOLD_DAYS=
AFFILIATE_MIN_WITHDRAW_RM=
# Keep existing remote stats config if currently used.
MEDIAX_STATS_BACKEND=
MEDIAX_STATS_NAMESPACE=
STATS_FILE_PATH=
# Heavy media worker remains GitHub Actions:
GITHUB_WORKER_OWNER=abangrenderofficial-oss
GITHUB_WORKER_REPO=mdab-129
GITHUB_WORKER_WORKFLOW=heavy-status-hq.yml
GITHUB_WORKER_REF=main
GITHUB_WORKER_DISPATCH_TIMEOUT_MS=12000

# IMPORTANT: Do not copy RAILWAY_*, RAILWAY_VOLUME_*, or any old PUBLIC_BASE_URL.
# Do not change webhook until Bot Hosting passes preflight and HTTPS health.
